# 集成测试与网关探针用的环境变量。
#
#   cp .env.example .env.local   然后填真实值
#   .env.local 已被 .gitignore 忽略，本文件（.env.example）不得填任何真实密钥。
#
# 用法：
#   set -a; source .env.local; set +a
#   node tools/cpa_probe.mjs          # 先探网关：可达性 / 鉴权 / 模型 / SSE
#   npm run test:integration          # 探通了再跑
#
# 三个变量全部必填。CPA_BASE_URL 没有默认值——历史上那个默认值指向已停用的主机，
# 而 skip 判定只看 API key，漏设 baseUrl 会静默打到错误的服务器上。

# CPA 网关地址，必须带 /v1 后缀
CPA_BASE_URL=http://188.239.16.167:8317/v1

# 调用 CPA 用的 key（CPA config.yaml 顶层 api-keys 里的任意一个）。
# 注意：这不是 MiniMax 的 key。MiniMax 的 key 配在 CPA 的供应商条目里，不出现在这里。
CPA_API_KEY=sk-cpa-_M585ZzGzDGkZnhlUmMuCknNgxSLx2kgaca9Ppp651w

# CPA 里给该模型设的 alias
CPA_MODEL=MiniMax-M2.7-highspeed
