{
  "name": "soul-link-desktop",
  "version": "0.1.0",
  "description": "AI-powered desktop companion for otome game fans",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:tsc\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:tsc": "tsc -p tsconfig.node.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on http://localhost:5173 dist-electron/main.js && electronmon .",
    "build": "npm run build:renderer && npm run build:main && npm run build:package",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build:package": "electron-builder",
    "build:win": "npm run build:renderer && npm run build:main && electron-builder --win",
    "build:mac": "npm run build:renderer && npm run build:main && electron-builder --mac",
    "preview": "vite preview",
    "test": "jest tests/unit/",
    "test:unit": "jest tests/unit/",
    "test:integration": "jest tests/integration/ --runInBand",
    "test:all": "jest --runInBand"
  },
  "electronmon": {
    "patterns": [
      "dist-electron/**/*.js"
    ],
    "logLevel": "quiet",
    "delay": 800
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0",
    "electronmon": "^2.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "electron-store": "^8.0.0",
    "i18next": "^25.8.20",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.8",
    "sql.js": "^1.14.1",
    "uuid": "^13.0.0",
    "zustand": "^4.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^electron$": "<rootDir>/tests/__mocks__/electron.ts"
    },
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }]
    }
  }
}
